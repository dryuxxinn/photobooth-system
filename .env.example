# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
DEBUG=True

# Camera Configuration: 'simulation', 'gphoto' (USB), or 'wifi' (Sony Alpha / PTP-IP)
CAMERA_DRIVER=simulation
CAMERA_MODEL=Canon EOS 700D
# For Wireless Cameras (e.g., Sony a6400 Smart Remote Control IP: 192.168.122.1, port 8080)
CAMERA_WIFI_IP=192.168.122.1
CAMERA_WIFI_PORT=8080
# Protocol: 'sony_http' (Sony Camera Remote JSON-RPC API) or 'ptpip' (gphoto2 --port ptpip:<ip>)
CAMERA_WIFI_PROTOCOL=sony_http

# Storage Configuration (relative or absolute)
STORAGE_BASE_DIR=./storage

# Photobooth Session Defaults
PHOTOS_PER_SESSION=3
COUNTDOWN_SECONDS=5
PREVIEW_DURATION_SECONDS=10

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://192.168.1.0/24
